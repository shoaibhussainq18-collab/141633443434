<div class="max-w-7xl mx-auto px-4 py-16 text-white">
  <h1 class="text-3xl font-black uppercase tracking-tight mb-8">{{ collection.title }}</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for product in collection.products %}
      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-4 flex flex-col justify-between">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}" class="w-full aspect-square object-contain mb-3 rounded-lg bg-neutral-950 p-2"/>
          {% endif %}
          <h3 class="text-sm font-bold text-white line-clamp-2">{{ product.title }}</h3>
          <p class="text-base font-black text-cyan-400 mt-2 font-mono">{{ product.price | money }}</p>
        </a>
      </div>
    {% endfor %}
  </div>
</div>
