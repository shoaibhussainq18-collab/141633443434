<div class="max-w-7xl mx-auto px-4 py-16 text-white">
  <h1 class="text-3xl font-black uppercase mb-6">Search Results</h1>
  {% if search.performed %}
    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-6">
      {% for item in search.results %}
        <div class="border border-neutral-800 bg-neutral-900 p-4 rounded-xl">
          <a href="{{ item.url }}" class="font-bold text-sm hover:text-cyan-400">{{ item.title }}</a>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
