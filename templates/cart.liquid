<div class="max-w-4xl mx-auto px-4 py-16 text-white">
  <h1 class="text-3xl font-black uppercase mb-8">Shopping Cart</h1>
  {% if cart.item_count > 0 %}
    <form action="/cart" method="post">
      <div class="space-y-4">
        {% for item in cart.items %}
          <div class="flex justify-between items-center border-b border-neutral-800 pb-4">
            <div>
              <p class="font-bold text-white">{{ item.product.title }}</p>
              <p class="text-xs text-neutral-400 font-mono">Qty: {{ item.quantity }}</p>
            </div>
            <p class="font-bold font-mono text-cyan-400">{{ item.line_price | money }}</p>
          </div>
        {% endfor %}
      </div>
      <div class="mt-8 text-right">
        <p class="text-2xl font-black font-mono">Total: <span class="text-cyan-400">{{ cart.total_price | money }}</span></p>
        <button type="submit" name="checkout" class="mt-4 bg-cyan-400 text-black font-black px-8 py-3.5 rounded-xl uppercase text-xs tracking-widest">Proceed to Checkout</button>
      </div>
    </form>
  {% else %}
    <p class="text-neutral-400">Your cart is currently empty.</p>
  {% endif %}
</div>
