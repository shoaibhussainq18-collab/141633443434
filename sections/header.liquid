<header class="sticky top-0 z-40 bg-black/90 backdrop-blur-md border-b border-neutral-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center space-x-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-black font-black text-xl shadow-[0_0_20px_rgba(0,229,255,0.4)] group-hover:scale-105 transition-transform">
        T
      </div>
      <div>
        <span class="text-xl font-black tracking-wider text-white">TECHNO<span class="text-cyan-400">.</span></span>
        <span class="text-[9px] uppercase tracking-widest text-neutral-400 block -mt-1 font-mono">FLAGSHIP HARDWARE</span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center space-x-6 text-xs uppercase font-bold tracking-wider text-neutral-300">
      <a href="#smartwatches" class="hover:text-cyan-400 transition-colors">Smartwatches</a>
      <a href="#headphones" class="hover:text-cyan-400 transition-colors">Headphones</a>
      <a href="#airbuds" class="hover:text-cyan-400 transition-colors">Airbuds</a>
      <a href="#keyboards" class="hover:text-cyan-400 transition-colors">Keyboards</a>
      <a href="#hardware" class="hover:text-cyan-400 transition-colors">Hardware &amp; Power</a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center space-x-4">
      <button type="button" onclick="openSearchModal()" class="text-neutral-400 hover:text-white p-2 text-sm cursor-pointer" title="Search catalog">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>

      <button type="button" onclick="toggleCartDrawer(true)" class="relative bg-neutral-900 border border-neutral-800 hover:border-cyan-500/50 text-white px-3.5 py-2 rounded-xl flex items-center space-x-2 cursor-pointer transition-all">
        <i class="fa-solid fa-cart-shopping text-cyan-400 text-sm"></i>
        <span class="text-xs font-bold" id="headerCartCount">0</span>
      </button>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "TECHNO Header",
  "settings": []
}
{% endschema %}
