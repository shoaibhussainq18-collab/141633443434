    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500">
      <p>&copy; 2026 TECHNO Inc. All rights reserved. Precision Technology Instruments.</p>
      <div class="flex space-x-6 mt-4 sm:mt-0 font-mono text-[11px]">
        <span>STATUS: 100% OPERATIONAL</span>
        <span>25 CERTIFIED PRODUCTS</span>
