<section class="relative overflow-hidden bg-gradient-to-b from-black via-neutral-950 to-black py-20 lg:py-28 border-b border-neutral-800 text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(0,229,255,0.12),transparent_70%)] pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="inline-flex items-center space-x-2 bg-neutral-900/90 border border-neutral-700/80 px-3.5 py-1.5 rounded-full mb-6">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span class="text-[11px] font-mono uppercase tracking-widest text-cyan-300">GEN-4 FLAGSHIP HARDWARE RELEASE</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-none uppercase">
          ENGINEERED <br/>
          <span class="bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">BEYOND LIMITS</span>
        </h1>
        <p class="mt-6 text-sm sm:text-base text-neutral-400 leading-relaxed max-w-xl">
          Aerospace Grade 5 Titanium smartwatches, planar magnetic audio monitors, gasket-mounted custom keyboards, and GaN wireless power. Zero compromises.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#smartwatches" class="bg-cyan-400 hover:bg-cyan-300 text-black font-black text-xs uppercase tracking-widest px-8 py-4 rounded-xl shadow-[0_0_25px_rgba(0,229,255,0.4)] transition-all">
            Shop Flagship Watch
          </a>
          <a href="#keyboards" class="bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-white font-bold text-xs uppercase tracking-widest px-8 py-4 rounded-xl transition-all">
            Explore Keyboards &amp; Audio
          </a>
        </div>
      </div>
      <div class="relative flex items-center justify-center">
        <div class="w-full max-w-md aspect-square bg-gradient-to-tr from-cyan-950/40 to-neutral-900/50 rounded-3xl border border-cyan-500/30 p-8 flex items-center justify-center relative shadow-[0_0_50px_rgba(0,229,255,0.15)]">
          <img src="https://shoaibhussainq18-collab.github.io/141633443434/images/smartwatch-ultra.jpg" alt="TECHNO Chrono Ultra Titanium" class="w-full h-full object-contain filter drop-shadow-[0_20px_40px_rgba(0,0,0,0.8)]"/>
          <div class="absolute bottom-6 left-6 bg-black/80 backdrop-blur-md border border-neutral-800 px-4 py-2.5 rounded-xl">
            <span class="text-[10px] font-mono text-cyan-400 uppercase tracking-widest block">FLAGSHIP TITANIUM</span>
            <span class="text-xs font-black text-white">Chrono Ultra Grade 5 Titanium</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "TECHNO Hero Banner",
  "settings": []
}
{% endschema %}
