<footer class="bg-[#111111] text-white pt-16 pb-12 mt-auto border-t border-neutral-800" data-purpose="site-footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-neutral-800">
      <div class="md:col-span-5 space-y-4">
        <h2 class="text-2xl font-black uppercase tracking-[0.25em]">{{ shop.name | default: 'TECHNO' }}</h2>
        <p class="text-xs text-neutral-400 max-w-sm leading-relaxed">
          Pioneering premium personal acoustic equipment and clean minimalistic modern consumer technology for creators, travelers, and audiophiles.
        </p>
      </div>
      <div class="md:col-span-7 flex flex-col justify-center">
        <h5 class="text-xs uppercase font-bold tracking-widest text-neutral-300 mb-2">Subscribe to the TECHNO Journal</h5>
        <p class="text-xs text-neutral-400 mb-4">Receive priority access to limited drops, firmware updates, and insider deals.</p>
        {% form 'customer', class: 'flex max-w-md' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input name="contact[email]" class="w-full bg-neutral-900 border border-neutral-700 text-sm px-4 py-2.5 rounded-l-lg text-white focus:outline-none focus:border-white placeholder-neutral-500" placeholder="Enter your email" type="email" required/>
          <button class="bg-white text-black font-semibold text-xs px-6 py-2.5 rounded-r-lg uppercase tracking-wider hover:bg-neutral-200 transition" type="submit">
            Join
          </button>
        {% endform %}
      </div>
    </div>

    <!-- Links Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-12 text-xs">
      <div>
        <h6 class="font-bold uppercase tracking-wider text-neutral-300 mb-4">Shop</h6>
        <ul class="space-y-2.5 text-neutral-400">
          <li><a class="hover:text-white transition" href="/collections/all">Headphones &amp; Earphones</a></li>
          <li><a class="hover:text-white transition" href="/collections/speakers">Wireless Speakers</a></li>
          <li><a class="hover:text-white transition" href="/collections/accessories">Laptop &amp; Mac Accessories</a></li>
          <li><a class="hover:text-white transition" href="/collections/outlet">Refurbished Outlet</a></li>
        </ul>
      </div>
      <div>
        <h6 class="font-bold uppercase tracking-wider text-neutral-300 mb-4">Customer Care</h6>
        <ul class="space-y-2.5 text-neutral-400">
          <li><a class="hover:text-white transition" href="/pages/track-order">Track Your Order</a></li>
          <li><a class="hover:text-white transition" href="/policies/shipping-policy">Shipping Policy</a></li>
          <li><a class="hover:text-white transition" href="/policies/refund-policy">Returns &amp; Exchanges</a></li>
          <li><a class="hover:text-white transition" href="/pages/contact">Support Center</a></li>
        </ul>
      </div>
      <div>
        <h6 class="font-bold uppercase tracking-wider text-neutral-300 mb-4">Company</h6>
        <ul class="space-y-2.5 text-neutral-400">
          <li><a class="hover:text-white transition" href="/pages/about">Our Design Philosophy</a></li>
          <li><a class="hover:text-white transition" href="/pages/about">Sustainability Initiatives</a></li>
          <li><a class="hover:text-white transition" href="/blogs/news">Journal &amp; News</a></li>
        </ul>
      </div>
      <div>
        <h6 class="font-bold uppercase tracking-wider text-neutral-300 mb-4">Legal &amp; Privacy</h6>
        <ul class="space-y-2.5 text-neutral-400">
          <li><a class="hover:text-white transition" href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a class="hover:text-white transition" href="/policies/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-neutral-800 flex flex-col md:flex-row items-center justify-between text-[11px] text-neutral-500">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name | default: 'TECHNO' }}. All rights reserved. Powered by Shopify.</p>
      <div class="flex items-center space-x-3 mt-4 md:mt-0 opacity-80">
        <span class="bg-neutral-800 px-2 py-1 rounded text-neutral-300 text-[10px] font-bold">VISA</span>
        <span class="bg-neutral-800 px-2 py-1 rounded text-neutral-300 text-[10px] font-bold">MASTERCARD</span>
        <span class="bg-neutral-800 px-2 py-1 rounded text-neutral-300 text-[10px] font-bold">APPLE PAY</span>
        <span class="bg-neutral-800 px-2 py-1 rounded text-neutral-300 text-[10px] font-bold">SHOP PAY</span>
        <span class="bg-neutral-800 px-2 py-1 rounded text-neutral-300 text-[10px] font-bold">PAYPAL</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
