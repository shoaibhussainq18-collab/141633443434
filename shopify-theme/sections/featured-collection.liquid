<!-- Best Sellers Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full border-t border-gray-100" data-purpose="related-products">
  <div class="text-center mb-12">
    <h2 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-widest text-black">{{ section.settings.title | default: 'BEST SELLER' }}</h2>
    <p class="text-xs text-gray-500 uppercase tracking-widest mt-1">{{ section.settings.subtitle | default: 'Discover popular audio gear and accessories' }}</p>
  </div>
  
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
    {% for product in collections[section.settings.collection].products limit: 4 %}
      <div class="group flex flex-col items-center">
        <a href="{{ product.url }}" class="relative w-full aspect-square bg-[#FBFBFB] border border-gray-100 rounded-xl overflow-hidden flex items-center justify-center p-6 mb-4 transition hover:shadow-md">
          {% if product.compare_at_price > product.price %}
            <span class="absolute bottom-3 left-3 bg-black text-white text-[10px] font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full">
              Sale
            </span>
          {% endif %}
          <img alt="{{ product.title | escape }}" class="object-contain w-full h-full group-hover:scale-105 transition-transform duration-300" src="{{ product.featured_image | image_url: width: 400 }}"/>
        </a>
        <h4 class="text-sm font-medium text-gray-900 group-hover:text-black text-center">{{ product.title }}</h4>
        <div class="flex items-center space-x-2 mt-1">
          {% if product.compare_at_price > product.price %}
            <span class="text-xs text-gray-400 line-through">{{ product.compare_at_price | money }}</span>
          {% endif %}
          <span class="text-xs font-bold text-black">{{ product.price | money }}</span>
        </div>
      </div>
    {% else %}
      <!-- Fallback Demo Products -->
      <div class="group flex flex-col items-center">
