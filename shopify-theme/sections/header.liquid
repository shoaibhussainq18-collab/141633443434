<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-gray-100" data-purpose="site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Primary Navigation -->
    <nav class="hidden md:flex items-center space-x-8 text-sm font-medium tracking-tight" data-purpose="desktop-nav">
      {% for link in linklists.main-menu.links %}
        <a class="{% if link.active %}text-gray-900 border-b-2 border-black pb-1 font-semibold{% else %}text-gray-600 hover:text-black pb-1 transition{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {% else %}
        <a class="text-gray-900 border-b-2 border-black pb-1 hover:text-black transition" href="/">Home</a>
        <a class="text-gray-600 hover:text-black pb-1 transition" href="/collections/all">Shop Now</a>
        <a class="text-gray-600 hover:text-black pb-1 transition" href="/collections">Categories</a>
        <a class="text-gray-600 hover:text-black pb-1 transition" href="/pages/contact">Contact</a>
      {% endfor %}
    </nav>

    <!-- Center Logo -->
    <div class="flex flex-col items-center" data-purpose="brand-logo">
      <a class="text-2xl md:text-3xl font-extrabold tracking-[0.25em] uppercase text-black leading-none" href="/">
        {{ shop.name | default: 'TECHNO' }}
      </a>
      <span class="text-[9px] tracking-[0.35em] text-gray-400 uppercase mt-0.5">Technology Shop</span>
    </div>

    <!-- Action Utilities -->
    <div class="flex items-center space-x-6" data-purpose="header-utilities">
      <a href="/search" aria-label="Search" class="p-2 text-gray-700 hover:text-black transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" aria-label="Account" class="hidden sm:inline-block p-2 text-gray-700 hover:text-black transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      {% endif %}

      <a href="/cart" aria-label="Cart" class="p-2 text-gray-700 hover:text-black relative transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25c-.67 0-1.188-.578-1.119-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="absolute top-1 right-0.5 bg-black text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
