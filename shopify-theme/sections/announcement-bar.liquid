<aside class="bg-[#F2F2F2] border-b border-gray-200 text-xs py-2 px-4 text-center font-normal tracking-wide text-gray-700" data-purpose="announcement-banner">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <span class="hidden md:inline text-gray-400">{{ section.settings.left_text | default: 'Free 30-Day Returns' }}</span>
    <p class="mx-auto md:mx-0 font-medium">{{ section.settings.announcement_text | default: 'Free shipping for all orders over $100' }}</p>
    <a href="/pages/contact" class="hidden md:inline text-gray-500 hover:text-black cursor-pointer transition">{{ section.settings.right_text | default: 'Need Help? Contact 24/7' }}</a>
  </div>
</aside>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Free shipping for all orders over $100"
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left Info",
      "default": "Free 30-Day Returns"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right Contact",
      "default": "Need Help? Contact 24/7"
    }
  ]
}
{% endschema %}
