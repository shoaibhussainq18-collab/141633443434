"Material": "1680D Ballistic Nylon + EVA Hardshell", "Dimensions": "210mm x 180mm x 55mm", "Weight": "130 grams"}, "inTheBox": ["1x TECHNO Magnetic Travel Case", "1x Carabiner Clip"]}]
    </script>

    <!-- Theme Interactive Script -->
    <script>
      let THEME_PRODUCTS = [];
      try {
        const raw = document.getElementById('techno-theme-db').textContent;
        THEME_PRODUCTS = JSON.parse(raw);
      } catch(e) {
        console.error("Failed to parse theme database", e);
      }

      let themeCart = [];

      function updateCartUI() {
        const totalCount = themeCart.reduce((sum, item) => sum + item.qty, 0);
        const headerBadge = document.getElementById('headerCartCount');
        if (headerBadge) headerBadge.textContent = totalCount;
        const drawerBadge = document.getElementById('drawerCartBadge');
        if (drawerBadge) drawerBadge.textContent = totalCount;

        const container = document.getElementById('themeCartItems');
        const emptyMsg = document.getElementById('themeCartEmpty');
        const subtotalEl = document.getElementById('themeCartSubtotal');

        let subtotal = 0;
        if (themeCart.length === 0) {
          if (emptyMsg) emptyMsg.style.display = 'block';
          if (subtotalEl) subtotalEl.textContent = '$0.00';
          return;
        }

        if (emptyMsg) emptyMsg.style.display = 'none';
        container.innerHTML = '';

        themeCart.forEach((item, idx) => {
          subtotal += item.price * item.qty;
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between gap-3 p-3 bg-neutral-950 border border-neutral-800 rounded-xl text-xs';
          row.innerHTML = `
            <img src="${item.img}" class="w-12 h-12 object-contain bg-neutral-900 rounded-lg p-1 border border-neutral-800"/>
            <div class="flex-1 min-w-0">
              <h4 class="font-bold text-white truncate">${item.title}</h4>
              <div class="text-neutral-400 font-mono mt-0.5">$${item.price.toFixed(2)} x ${item.qty}</div>
            </div>
            <div class="flex items-center space-x-2">
              <span class="font-black text-cyan-400 font-mono">$${(item.price * item.qty).toFixed(2)}</span>
              <button onclick="removeFromThemeCart(${idx})" class="text-red-400 hover:text-red-300 p-1 cursor-pointer">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </div>
          `;
          container.appendChild(row);
        });

        if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
      }

      function addToCart(productId, qty = 1) {
        const p = THEME_PRODUCTS.find(i => i.id === productId);
        if (!p) return;
        const existing = themeCart.find(i => i.id === productId);
        const img = p.images[0].startsWith('images/') ? `https://shoaibhussainq18-collab.github.io/141633443434/${p.images[0]}` : p.images[0];
        if (existing) {
          existing.qty += qty;
        } else {
          themeCart.push({ id: p.id, title: p.title, price: p.price, img: img, qty: qty });
        }
        updateCartUI();
        showThemeToast(`Added "${p.title}" to cart!`);
      }

      function removeFromThemeCart(idx) {
        themeCart.splice(idx, 1);
        updateCartUI();
      }

      function toggleCartDrawer(open) {
        const el = document.getElementById('themeCartDrawer');
        if (open) {
          el.classList.remove('hidden');
          el.classList.add('flex');
        } else {
          el.classList.add('hidden');
          el.classList.remove('flex');
        }
      }

      function showThemeToast(msg) {
        const toast = document.getElementById('themeToast');
        const text = document.getElementById('themeToastMsg');
        text.textContent = msg;
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 2500);
      }

      function openQuickView(productId) {
        const p = THEME_PRODUCTS.find(i => i.id === productId);
        if (!p) return;
        const img = p.images[0].startsWith('images/') ? `https://shoaibhussainq18-collab.github.io/141633443434/${p.images[0]}` : p.images[0];
        document.getElementById('qvModalImg').src = img;
        document.getElementById('qvModalCategory').textContent = p.category.toUpperCase();
        document.getElementById('qvModalTitle').textContent = p.title;
        document.getElementById('qvModalPrice').textContent = `$${p.price.toFixed(2)}`;
        document.getElementById('qvModalCompare').textContent = `$${p.compareAtPrice.toFixed(2)}`;
        document.getElementById('qvModalDesc').textContent = p.description;

        document.getElementById('qvModalAddBtn').onclick = () => {
          addToCart(productId);
          closeQuickView();
          toggleCartDrawer(true);
        };
        document.getElementById('qvModalBuyBtn').onclick = () => {
          closeQuickView();
          openDirectCheckout(productId);
        };

        const modal = document.getElementById('themeQuickViewModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function closeQuickView() {
        const modal = document.getElementById('themeQuickViewModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      function openDirectCheckout(productId) {
        const p = THEME_PRODUCTS.find(i => i.id === productId);
        if (!p) return;
        document.getElementById('coItemTitle').textContent = p.title;
        document.getElementById('coItemTotal').textContent = `$${p.price.toFixed(2)}`;
        const modal = document.getElementById('themeCheckoutModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function openThemeCheckoutModal() {
        if (themeCart.length === 0) {
          showThemeToast("Your cart is empty!");
          return;
        }
        const total = themeCart.reduce((s, i) => s + (i.price * i.qty), 0);
        const title = themeCart.map(i => `${i.title} (x${i.qty})`).join(', ');
        toggleCartDrawer(false);
        document.getElementById('coItemTitle').textContent = title;
        document.getElementById('coItemTotal').textContent = `$${total.toFixed(2)}`;
        const modal = document.getElementById('themeCheckoutModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function closeCheckoutModal() {
        const modal = document.getElementById('themeCheckoutModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      function submitThemeOrder(e) {
        e.preventDefault();
        const name = document.getElementById('coCustomerName').value;
        const city = document.getElementById('coCity').value;
        const orderId = 'TCH-' + Math.floor(100000 + Math.random() * 900000);
        closeCheckoutModal();
        alert(`🎉 Thank you, ${name}!

Your order #${orderId} has been confirmed.
We are preparing express dispatch to ${city}.
Tracking information will be emailed shortly.`);
        themeCart = [];
        updateCartUI();
        showThemeToast(`Order #${orderId} confirmed successfully!`);
        e.target.reset();
      }

      function openSearchModal() {
        const modal = document.getElementById('themeSearchModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.getElementById('themeSearchInput').focus();
      }

      function closeSearchModal() {
        const modal = document.getElementById('themeSearchModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      function handleThemeSearch(query) {
        const q = query.trim().toLowerCase();
        const resultsEl = document.getElementById('themeSearchResults');
        if (!q) {
          resultsEl.innerHTML = '<p class="text-xs text-neutral-500 py-4 text-center">Type to search the entire TECHNO catalog...</p>';
          return;
        }
        const matches = THEME_PRODUCTS.filter(p => 
          p.title.toLowerCase().includes(q) || 
          p.category.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q)
        );
        if (matches.length === 0) {
          resultsEl.innerHTML = '<p class="text-xs text-neutral-500 py-4 text-center">No hardware found matching "' + q + '"</p>';
          return;
        }
        resultsEl.innerHTML = matches.map(p => {
          const img = p.images[0].startsWith('images/') ? `https://shoaibhussainq18-collab.github.io/141633443434/${p.images[0]}` : p.images[0];
          return `
            <div class="flex items-center justify-between p-2.5 bg-neutral-950 border border-neutral-800 rounded-xl hover:border-cyan-500/50 transition-colors">
              <div class="flex items-center space-x-3">
                <img src="${img}" class="w-10 h-10 object-contain bg-neutral-900 rounded-lg p-1"/>
                <div>
                  <h4 class="text-xs font-bold text-white">${p.title}</h4>
                  <span class="text-[10px] text-cyan-400 font-mono">$${p.price.toFixed(2)} &bull; ${p.category}</span>
                </div>
              </div>
              <button onclick="openQuickView('${p.id}'); closeSearchModal();" class="text-xs font-bold text-cyan-400 hover:text-cyan-300 px-3 py-1 bg-neutral-900 rounded-lg border border-neutral-800">
                View
              </button>
            </div>
          `;
        }).join('');
      }

      function handleThemeSubscribe(e) {
        e.preventDefault();
        showThemeToast("Subscribed! Welcome to TECHNO VIP Hardware updates.");
        e.target.reset();
      }
    </script>
  </body>
</html>
