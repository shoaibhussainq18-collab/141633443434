<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#00e5ff">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Tailwind CSS v3 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #0a0a0a;
        color: #e5e5e5;
        overflow-x: hidden;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0a0a0a;
      }
      ::-webkit-scrollbar-thumb {
        background: #262626;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #00e5ff;
      }
    </style>

    {{ content_for_header }}
  </head>

  <body class="bg-neutral-950 text-neutral-100 antialiased selection:bg-cyan-400 selection:text-black">
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Slide-Over Cart Drawer -->
    <div class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden" id="themeCartDrawer">
      <div class="absolute right-0 top-0 bottom-0 w-full max-w-md bg-neutral-900 border-l border-neutral-800 shadow-2xl flex flex-col justify-between">
        <div class="p-5 border-b border-neutral-800 flex items-center justify-between bg-neutral-950">
          <div class="flex items-center space-x-2.5">
            <i class="fa-solid fa-cart-shopping text-cyan-400"></i>
            <h3 class="text-sm font-black text-white uppercase tracking-wider">Your TECHNO Cart</h3>
            <span class="bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-[10px] font-mono px-2 py-0.5 rounded-full" id="drawerCartBadge">0</span>
          </div>
          <button type="button" class="text-neutral-400 hover:text-white p-1 cursor-pointer" onclick="toggleCartDrawer(false)">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>

        <div class="p-5 overflow-y-auto flex-1 space-y-3" id="themeCartItems">
          <div class="text-center py-20" id="themeCartEmpty">
            <div class="w-16 h-16 bg-neutral-800 rounded-full flex items-center justify-center mx-auto text-neutral-500 text-2xl mb-4">
              <i class="fa-solid fa-bag-shopping"></i>
            </div>
            <p class="text-sm font-bold text-white">Your cart is empty</p>
            <p class="text-xs text-neutral-400 mt-1">Explore our 25 flagship tech hardware products.</p>
          </div>
        </div>

        <div class="p-5 border-t border-neutral-800 bg-neutral-950">
          <div class="flex items-center justify-between text-sm font-bold text-white mb-2">
            <span>Subtotal:</span>
            <span id="themeCartSubtotal" class="font-mono text-cyan-400 font-black">$0.00</span>
          </div>
          <p class="text-[11px] text-emerald-400 font-mono mb-4">
            <i class="fa-solid fa-circle-check mr-1"></i> Express Courier Shipping Included
          </p>
          <button type="button" class="w-full bg-cyan-400 hover:bg-cyan-300 text-black font-black py-3.5 rounded-xl text-xs uppercase tracking-widest transition-all shadow-[0_0_20px_rgba(0,229,255,0.3)] cursor-pointer mb-2.5" onclick="openThemeCheckoutModal()">
            Proceed to Checkout
          </button>
          <button type="button" class="w-full border border-neutral-800 text-neutral-400 hover:text-white font-bold py-2.5 rounded-xl text-xs uppercase tracking-wider hover:bg-neutral-900 transition-colors cursor-pointer" onclick="toggleCartDrawer(false)">
            Continue Shopping
          </button>
        </div>
      </div>
    </div>

    <!-- Quick View Modal -->
    <div class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4" id="themeQuickViewModal">
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl max-w-2xl w-full p-6 relative shadow-2xl">
        <button type="button" class="absolute top-4 right-4 text-neutral-400 hover:text-white text-lg p-1 cursor-pointer" onclick="closeQuickView()">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
          <div class="aspect-square bg-neutral-950 border border-neutral-800 rounded-xl flex items-center justify-center p-4">
            <img id="qvModalImg" src="" alt="" class="w-full h-full object-contain"/>
          </div>
          <div>
            <span class="text-[10px] uppercase font-mono text-cyan-400 tracking-widest" id="qvModalCategory">CATEGORY</span>
            <h3 class="text-lg font-black text-white mt-1 leading-tight" id="qvModalTitle">Product Title</h3>
            <div class="mt-2 flex items-baseline space-x-2">
              <span class="text-2xl font-black text-white font-mono" id="qvModalPrice">$0.00</span>
              <span class="text-xs text-neutral-500 line-through font-mono" id="qvModalCompare">$0.00</span>
            </div>
            <p class="text-xs text-neutral-400 mt-3 leading-relaxed" id="qvModalDesc">Description</p>
            <div class="mt-6 flex flex-col gap-2">
              <button type="button" class="w-full bg-cyan-400 hover:bg-cyan-300 text-black font-black text-xs uppercase tracking-wider py-3 rounded-xl transition-all cursor-pointer shadow-[0_0_15px_rgba(0,229,255,0.3)]" id="qvModalAddBtn">
                Add To Cart
              </button>
              <button type="button" class="w-full bg-neutral-800 hover:bg-neutral-700 text-white font-bold text-xs uppercase tracking-wider py-3 rounded-xl transition-colors cursor-pointer border border-neutral-700" id="qvModalBuyBtn">
                Direct Buy Now
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Direct Checkout / Order Modal -->
    <div class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4" id="themeCheckoutModal">
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl max-w-lg w-full p-6 relative shadow-2xl">
        <button type="button" class="absolute top-4 right-4 text-neutral-400 hover:text-white text-lg p-1 cursor-pointer" onclick="closeCheckoutModal()">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="flex items-center space-x-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-lg">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <div>
            <h3 class="text-base font-black text-white uppercase tracking-wider">Fast Direct Checkout</h3>
            <p class="text-xs text-neutral-400">Complete your order with express global dispatch</p>
          </div>
        </div>

        <div class="bg-neutral-950 border border-neutral-800 rounded-xl p-3.5 mb-5 text-xs">
          <div class="flex justify-between items-center text-white font-bold">
            <span id="coItemTitle">TECHNO Hardware</span>
            <span id="coItemTotal" class="text-cyan-400 font-mono font-black">$0.00</span>
          </div>
          <div class="text-[11px] text-emerald-400 font-mono mt-1">
            ✓ Free 2-3 Day Express Shipping Included
          </div>
        </div>

        <form id="themeCheckoutForm" onsubmit="submitThemeOrder(event)" class="space-y-3.5 text-xs">
          <div>
            <label class="block font-bold text-neutral-300 mb-1">Full Name *</label>
            <input type="text" id="coCustomerName" required placeholder="John Doe" class="w-full bg-neutral-950 rounded-lg border border-neutral-800 text-white text-xs py-2.5 px-3 focus:outline-none focus:border-cyan-400"/>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-neutral-300 mb-1">Email / Phone *</label>
              <input type="text" id="coContact" required placeholder="contact@example.com" class="w-full bg-neutral-950 rounded-lg border border-neutral-800 text-white text-xs py-2.5 px-3 focus:outline-none focus:border-cyan-400"/>
            </div>
            <div>
              <label class="block font-bold text-neutral-300 mb-1">City / Country *</label>
              <input type="text" id="coCity" required placeholder="New York, USA" class="w-full bg-neutral-950 rounded-lg border border-neutral-800 text-white text-xs py-2.5 px-3 focus:outline-none focus:border-cyan-400"/>
            </div>
          </div>
          <div>
            <label class="block font-bold text-neutral-300 mb-1">Delivery Address *</label>
            <textarea id="coAddress" required rows="2" placeholder="Street Address, Apartment, Postal Code" class="w-full bg-neutral-950 rounded-lg border border-neutral-800 text-white text-xs py-2.5 px-3 focus:outline-none focus:border-cyan-400"></textarea>
          </div>
          <button type="submit" class="w-full bg-cyan-400 hover:bg-cyan-300 text-black font-black py-3.5 rounded-xl text-xs uppercase tracking-widest transition-all shadow-[0_0_20px_rgba(0,229,255,0.4)] cursor-pointer mt-2">
            Confirm Order &bull; Pay on Delivery / Express
          </button>
        </form>
      </div>
    </div>

    <!-- Search Modal -->
    <div class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4" id="themeSearchModal">
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl max-w-xl w-full p-6 relative shadow-2xl">
        <button type="button" class="absolute top-4 right-4 text-neutral-400 hover:text-white text-lg p-1 cursor-pointer" onclick="closeSearchModal()">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-sm font-black text-white uppercase tracking-wider mb-4 flex items-center space-x-2">
          <i class="fa-solid fa-magnifying-glass text-cyan-400"></i>
          <span>Search 25 Tech Hardware Models</span>
        </h3>
        <input type="text" id="themeSearchInput" placeholder="Type watch, headphones, keyboard, airbuds..." oninput="handleThemeSearch(this.value)" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-cyan-400"/>
        <div id="themeSearchResults" class="mt-4 max-h-80 overflow-y-auto space-y-2">
          <p class="text-xs text-neutral-500 py-4 text-center">Type to search the entire TECHNO catalog...</p>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div class="fixed bottom-6 right-6 z-50 bg-neutral-900 border border-cyan-500/50 text-white text-xs font-bold px-4 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none" id="themeToast">
      <i class="fa-solid fa-circle-check text-cyan-400 text-sm"></i>
      <span id="themeToastMsg">Item updated!</span>
    </div>

    <!-- Embedded Theme Products Database -->
